{
  "enabled": {
    "description": "启用小天干作息",
    "type": "bool",
    "default": true
  },
  "bot_name": {
    "description": "角色名称",
    "type": "string",
    "hint": "用于监测器文案中的 {bot_name} 占位符，不要把角色名写死在代码中。",
    "default": "小天干"
  },
  "timezone": {
    "description": "作息时区",
    "type": "string",
    "default": "Asia/Shanghai"
  },
  "provider_id": {
    "description": "预告和回归使用的 LLM Provider",
    "type": "string",
    "hint": "留空跟随对应会话当前模型。",
    "default": "",
    "_special": "select_provider"
  },
  "bot_profiles": {
    "description": "按 Bot self_id 覆盖配置",
    "type": "list",
    "hint": "同一 AstrBot 连接多个角色 Bot 时使用。每项填写 bot_id，并可覆盖 bot_name、wake_window、sleep_window、daytime_away、pre_away、group_return、return_queue、reasons、provider_id 等同名字段；未写字段继承全局默认。",
    "default": []
  },
  "wake_window": {
    "description": "每日起床区间",
    "type": "object",
    "items": {
      "start": {"description": "开始", "type": "string", "default": "08:00"},
      "end": {"description": "结束", "type": "string", "default": "10:00"}
    }
  },
  "sleep_window": {
    "description": "每日睡觉区间（允许跨午夜）",
    "type": "object",
    "items": {
      "start": {"description": "开始", "type": "string", "default": "23:00"},
      "end": {"description": "结束", "type": "string", "default": "01:00"}
    }
  },
  "daytime_away": {
    "description": "白天临时离开",
    "type": "object",
    "items": {
      "enabled": {"description": "启用", "type": "bool", "default": true},
      "total_minutes_min": {"description": "每日总时长最小分钟", "type": "int", "default": 30},
      "total_minutes_max": {"description": "每日总时长最大分钟", "type": "int", "default": 120},
      "segments_min": {"description": "最少段数", "type": "int", "default": 1},
      "segments_max": {"description": "最多段数", "type": "int", "default": 4},
      "segment_minutes_min": {"description": "单段最短分钟", "type": "int", "default": 10},
      "segment_minutes_max": {"description": "单段最长分钟", "type": "int", "default": 60}
    }
  },
  "pre_away": {
    "description": "离线前私聊预告",
    "type": "object",
    "items": {
      "enabled": {"description": "启用", "type": "bool", "default": true},
      "advance_minutes": {"description": "提前分钟数", "type": "int", "default": 5},
      "active_private_window_minutes": {"description": "私聊活跃判定分钟", "type": "int", "default": 5},
      "standalone_fallback_seconds": {
        "description": "等待正常回复顺带预告的秒数",
        "type": "int",
        "hint": "超过该时间仍没有正常回复，插件为此私聊单独调用一次模型。",
        "default": 60
      }
    }
  },
  "group_return": {
    "description": "群聊回归抽样",
    "type": "object",
    "items": {
      "sample_rate": {"description": "抽样比例", "type": "float", "default": 0.3},
      "sample_fluctuation": {"description": "相对浮动", "type": "float", "default": 0.2}
    }
  },
  "return_queue": {
    "description": "回归发送队列",
    "type": "object",
    "items": {
      "first_reply_delay_min_seconds": {"description": "首条最短延迟秒数", "type": "int", "default": 20},
      "first_reply_delay_max_seconds": {"description": "首条最长延迟秒数", "type": "int", "default": 120},
      "between_reply_delay_min_seconds": {"description": "回复间最短秒数", "type": "int", "default": 8},
      "between_reply_delay_max_seconds": {"description": "回复间最长秒数", "type": "int", "default": 90},
      "long_reply_min_delay_seconds": {"description": "长内容最短延迟秒数", "type": "int", "default": 30},
      "long_text_threshold": {"description": "长内容判定字符数", "type": "int", "default": 160},
      "max_delay_seconds": {"description": "单次最大延迟秒数", "type": "int", "default": 300}
    }
  },
  "reasons": {
    "description": "离线原因与固定监测器文案",
    "type": "object",
    "items": {
      "daytime": {
        "description": "白天原因列表",
        "type": "list",
        "hint": "每项需包含 id、pre_away_fact、monitor_messages。监测器文案可使用 {bot_name}。",
        "default": [
          {
            "id": "dessert_shop",
            "pre_away_fact": "几分钟后去甜品店，可能无法及时回复",
            "monitor_messages": ["【小天干监测器提示】{bot_name}去甜品店了，不在手机跟前……"]
          },
          {
            "id": "daytime_nap",
            "pre_away_fact": "几分钟后小睡一会儿，可能无法及时回复",
            "monitor_messages": ["【小天干监测器提示】{bot_name}睡午觉去了，暂时没在看手机……"]
          }
        ]
      },
      "night_sleep": {
        "description": "夜间睡眠",
        "type": "object",
        "items": {
          "pre_away_fact": {"description": "预告事实", "type": "string", "default": "几分钟后准备睡觉，之后可能无法及时回复"},
          "monitor_messages": {
            "description": "固定监测器文案池",
            "type": "list",
            "default": ["【小天干监测器提示】{bot_name}已经睡着了，暂时看不到消息……"]
          }
        }
      }
    }
  },
  "scheduler_interval_seconds": {
    "description": "后台状态检查间隔秒数",
    "type": "float",
    "default": 3.0
  }
}
